{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(gh repo *)",
      "Bash(gh auth *)"
    ],
    "deny": [
      "Bash(gh repo delete *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-tests.sh" }
        ]
      }
    ]
  }
}
